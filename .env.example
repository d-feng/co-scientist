# Co-scientist environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── LLM API Keys ──────────────────────────────────────────────────────────────

# Required for Claude models (claude-haiku, claude-sonnet, claude-opus)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required for OpenAI models (gpt-4o, gpt-4-turbo)
# OPENAI_API_KEY=your_openai_api_key_here

# Required for Gemini models (gemini-2.0-flash)
# GOOGLE_API_KEY=your_google_api_key_here

# ── Data Directories ──────────────────────────────────────────────────────────

# Shared data directory for Biomni/GEO data lake (downloaded once, reused across runs)
# Default: ~/biomni_data
# Windows example:
# COSCIENTIST_DATA_DIR=C:\Users\yourname\co_scientist_data
# Linux / Mac example:
# COSCIENTIST_DATA_DIR=/data/co_scientist_data

# ── Optional: NCBI API Key ────────────────────────────────────────────────────

# Raises GEO/NCBI rate limit from 3 to 10 requests/sec
# Get one free at: https://www.ncbi.nlm.nih.gov/account/
# NCBI_API_KEY=your_ncbi_api_key_here

# ── Optional: Custom API Endpoint ─────────────────────────────────────────────

# Use a LiteLLM or Ollama gateway instead of direct Anthropic/OpenAI API
# Useful for: local models, cost control, corporate proxies
# ANTHROPIC_BASE_URL=http://localhost:4000
# OPENAI_BASE_URL=http://localhost:4000
